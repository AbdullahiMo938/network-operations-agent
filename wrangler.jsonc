{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "network-operations-agent",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-18",
	"compatibility_flags": ["nodejs_compat"],
	"migrations": [
		{
			"new_sqlite_classes": [
				"MyDurableObject"
			],
			"tag": "v1"
		},
		{
			"new_sqlite_classes": [
				"NetworkOperationsAgent"
			],
			"tag": "v2"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "MyDurableObject",
				"name": "MY_DURABLE_OBJECT"
			},
			{
				"class_name": "NetworkOperationsAgent",
				"name": "NETWORK_OPERATIONS_AGENT"
			}
		]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
	